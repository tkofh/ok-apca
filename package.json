{
	"name": "ok-apca",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "pnpm build && changeset publish",
		"check": "biome check --write .",
		"check:force": "biome check --write --unsafe .",
		"check:report": "biome check  .",
		"deps:reinstall": "pnpm dlx rimraf --glob node_modules packages/*/node_modules pnpm-lock.yaml && pnpm install",
		"deps:upgrade": "pnpm update --recursive --latest && pnpm dedupe",
		"dev": "turbo run dev --filter=playground...",
		"format": "biome format --write .",
		"preview": "turbo watch preview",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"knip": "knip"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@changesets/cli": "^2.30.0",
		"@types/node": "^25.5.0",
		"knip": "^5.86.0",
		"turbo": "^2.8.16",
		"typescript": "5.9.3"
	},
	"packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
	"engines": {
		"node": ">=24"
	}
}
