{
	"name": "ok-apca",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"changeset": "changeset",
		"changeset:version": "changeset version",
		"changeset:publish": "pnpm build && changeset publish",
		"check": "biome check --write .",
		"check:force": "biome check --write --unsafe .",
		"check:report": "biome check  .",
		"deps:reinstall": "pnpm dlx rimraf --glob node_modules packages/*/node_modules pnpm-lock.yaml && pnpm install",
		"deps:upgrade": "pnpm update --recursive --latest && pnpm dedupe",
		"dev": "turbo run dev --filter=playground...",
		"format": "biome format --write .",
		"preview": "turbo watch preview",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"knip": "knip"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@changesets/cli": "^2.30.0",
		"@types/node": "^25.5.0",
		"knip": "^5.86.0",
		"turbo": "^2.8.14",
		"typescript": "5.9.3"
	},
	"packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
	"engines": {
		"node": ">=24"
	}
}
